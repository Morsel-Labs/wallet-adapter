{
  "name": "@morsel-wallet/adapter",
  "version": "0.2.0",
  "type": "module",
  "description": "Wallet adapter for Morsel / Cookie Chain: core, React hooks, and the Morsel connect widget",
  "scripts": {
    "build": "tsc && node scripts/fix-extensions.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "size": "node scripts/measure-bundle.mjs",
    "playground": "node playground/serve.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.87.6",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.87.6",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5"
  },
  "keywords": [
    "wallet",
    "adapter",
    "morsel",
    "cookie",
    "chain",
    "solana",
    "svm",
    "react",
    "connect",
    "wallet-connect",
    "qr"
  ],
  "license": "MIT",
  "dependencies": {
    "@wallet-standard/app": "^1.1.0",
    "bs58": "^6.0.0",
    "eventemitter3": "^5.0.1",
    "tweetnacl": "^1.0.3"
  }
}
